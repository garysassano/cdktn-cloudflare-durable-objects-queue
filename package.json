{
  "name": "cdktn-cloudflare-durable-objects-queue",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "cdktn": "cdktn",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm synth",
    "deploy": "pnpm bundle && cdktn deploy --auto-approve",
    "destroy": "cdktn destroy --auto-approve",
    "dev": "wrangler dev",
    "diff": "pnpm bundle && cdktn diff",
    "format": "biome format --write .",
    "gen": "cdktn get",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pretest": "pnpm bundle",
    "pretest:watch": "pnpm bundle",
    "synth": "pnpm bundle && cdktn synth",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker/tsconfig.json",
    "types": "wrangler types"
  },
  "dependencies": {
    "cdktn": "^0.24.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^24.13.3",
    "cdktn-cli": "^0.24.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.125.0"
  }
}
